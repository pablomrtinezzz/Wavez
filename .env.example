# Copy to .env.local (never commit it) and set the same values in Vercel →
# Project → Settings → Environment Variables.

# Supabase → Project Settings → API (or "API Keys")
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# The SECRET key (sb_secret_… or the legacy service_role key). Server-side only:
# never prefix it with NEXT_PUBLIC_ and never paste it in the browser.
SUPABASE_SECRET_KEY=

# Optional
# NEXT_PUBLIC_SITE_URL=https://wavez-pi.vercel.app
# MARINE_SNAPSHOT_URL=https://raw.githubusercontent.com/pablomrtinezzz/Wavez/data/marine-snapshot.json
